# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Bearer token for the Clipboard CRM API.
CLIPBOARD_API_TOKEN=

# Optional. Defaults to the assessment API.
CLIPBOARD_API_BASE_URL=https://analyst-assessment-production.up.railway.app/api/v1

# Optional. When true, approved proposals record the intended calls without sending them.
DRY_RUN=true

# Optional. Set only after a human has confirmed which account is the Bellhaven parent.
BELLHAVEN_PARENT_ACCOUNT_ID=
